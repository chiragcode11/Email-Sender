# Application Settings
APP_NAME="Email Automation System"
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./email_automation.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Gmail SMTP
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google OAuth (for Gmail API - optional)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# MongoDB (optional)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=email_automation

# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Email Tracking
TRACKING_DOMAIN=http://localhost:8000
TRACKING_PIXEL_ROUTE=/track/open
TRACKING_CLICK_ROUTE=/track/click

# Rate Limiting
DEFAULT_DAILY_LIMIT=500
DEFAULT_HOURLY_LIMIT=50

# Warm-up Settings
WARMUP_ENABLED=True
WARMUP_START_VOLUME=20
WARMUP_GROWTH_RATE=2.0
WARMUP_MAX_DAYS=14

# SpamAssassin
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WebSocket
WEBSOCKET_CORS_ALLOWED_ORIGINS=*
